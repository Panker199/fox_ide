<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="17.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Name>FOX IDE</Name>
    <RootNamespace>fox-ide</RootNamespace>
    <OutputType>Library</OutputType>
    <StartupFile>src\main.jsx</StartupFile>
    <TestFramework>Jest</TestFramework>
    <NodeJsCommandOptions>--experimental-modules</NodeJsCommandOptions>
    <InstallDependencies>true</InstallDependencies>
    <LaunchBrowser>false</LaunchBrowser>
    <JavaScriptTestFramework>Jest</JavaScriptTestFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.js" />
    <Compile Include="src\**\*.jsx" />
  </ItemGroup>
</Project>

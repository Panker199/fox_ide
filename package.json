{
  "name": "fox-ide",
  "version": "1.0.0",
  "description": "Clean, minimalist glassmorphism IDE",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"node server.js\" \"vite --host\"",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-html": "^6.4.5",
    "@codemirror/lang-javascript": "^6.2.1",
    "@codemirror/lang-python": "^6.1.3",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@fontsource/cascadia-code": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@uiw/react-codemirror": "^4.21.0",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
